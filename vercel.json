{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.viralhooks.app" }],
      "destination": "https://viralhooks.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://snapdance-production.up.railway.app/api/$1"
    }
  ]
}
